parameters:
	ignoreErrors:
		-
			message: '#^Unable to resolve the template type T in call to function rest_sanitize_boolean$#'
			identifier: argument.templateType
			count: 1
			path: src/Admin/Settings.php

		-
			message: '#^Static method Cooked\\Admin\\Updates\:\:fix_recipe_line_endings\(\) is unused\.$#'
			identifier: method.unused
			count: 1
			path: src/Admin/Updates.php

		-
			message: '#^Static method Cooked\\Admin\\Updates\:\:purge_legacy_related_recipes_cache\(\) is unused\.$#'
			identifier: method.unused
			count: 1
			path: src/Admin/Updates.php

		-
			message: '#^Static method Cooked\\Admin\\Updates\:\:remove_recipes_from_cooked_user_meta\(\) is unused\.$#'
			identifier: method.unused
			count: 1
			path: src/Admin/Updates.php

		-
			message: '#^Unable to resolve the template type T in call to function rest_sanitize_boolean$#'
			identifier: argument.templateType
			count: 1
			path: src/Import/Import.php
