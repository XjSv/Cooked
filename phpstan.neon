# PHPStan configuration for Cooked

includes:
    - phpstan-baseline.neon

parameters:
    level: 8
    paths:
        - includes/
        - src/
    bootstrapFiles:
        - src/aliases.php
        - tests/phpstan/bootstrap.php
    scanFiles:
        - tests/phpstan/stubs.php

    # WordPress docblocks are not reliable enough to treat as certain.
    treatPhpDocTypesAsCertain: false

    phpVersion: 80200
