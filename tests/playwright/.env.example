# Copy to .env in this directory (Playwright tests).
#
# DDEV Playwright defaults to this URL when WP_BASE_URL is unset.
# Without DDEV, Playwright uses http://localhost:8888 (wp-env).
WP_BASE_URL=https://dev.mimisrecipes.ddev.site
#
# Optional admin fixture override. Default is e2e_admin, created by Playwright globalSetup.
# WP_ADMIN_USER=e2e_admin
# WP_ADMIN_PASSWORD=password
