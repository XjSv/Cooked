    await page.goto(`/?p=${testPageId}`, { waitUntil: 'networkidle' });
    
    // Check that recipe images are not visible
    const recipeImages = page.locator('.cooked-related-recipes-grid .cooked-recipe-image');
    const count = await recipeImages.count();
    expect(count).toBe(0);
    
    // Cleanup
    if (testPageId) {
